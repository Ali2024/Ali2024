# ---------------------------------------------------------------------------
# Searchlight — environment variables
# Copy this file to `.env` and fill in every value. Real multi-user mode is
# enabled only when Google OAuth, PostgreSQL AND the encryption key are all set.
# ---------------------------------------------------------------------------

# --- Google Cloud OAuth 2.0 (Web application) ------------------------------
# Add http://localhost:4173/auth/google/callback to "Authorized redirect URIs"
# in Google Cloud Console (APIs & Services -> Credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/google/callback

# --- PostgreSQL (required for multiple real users & persistence) ------------
# Use any Postgres 13+. Example DSN for a local server:
#   postgres://user:password@localhost:5432/searchlight
# The schema is applied automatically on server start (`npm run dev`) or
# manually with `npm run db:migrate`.
DATABASE_URL=postgres://searchlight:searchlight@localhost:5432/searchlight

# --- Token encryption key (AES-256-GCM) --------------------------------------
# Used to encrypt each user's Google refresh/access tokens before they are
# written to PostgreSQL. Generate a strong value:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32

# --- Session ----------------------------------------------------------------
# Secret used to sign the session cookie. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# --- Server ------------------------------------------------------------------
PORT=4173
NODE_ENV=development
